<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_card"
    android:padding="4dp">

    <!-- Boton Conectar / Desconectar -->
    <LinearLayout
        android:id="@+id/widget_connect_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_pill_gray"
        android:padding="2dp">

        <ImageView
            android:id="@+id/widget_connect_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_switch_right"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_connect_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Conectar"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Boton Bloquear / Desbloquear -->
    <LinearLayout
        android:id="@+id/widget_lock_button"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/widget_pill_gray"
        android:padding="2dp">

        <ImageView
            android:id="@+id/widget_lock_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/widget_lock_open"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_lock_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Desbloquear"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
